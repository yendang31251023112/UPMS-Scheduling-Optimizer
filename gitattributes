# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted to LF on checkout
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf

# Declare binary files
*.png binary
*.jpg binary
*.pdf binary
*.docx binary
